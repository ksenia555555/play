import sqlite3
from datetime import datetime

# ---------- РАСЧЁТ КБЖУ ----------
def calculate_bmr(weight, height, age, gender):
    """Базовый уровень метаболизма (BMR) по формуле Миффлина-Сан-Жеора"""
    if gender == 'male':
        return 10 * weight + 6.25 * height - 5 * age + 5
    else:
        return 10 * weight + 6.25 * height - 5 * age - 161

def calculate_tdee(bmr, activity_level):
    """Общий расход калорий с учётом активности"""
    factors = {
        '1': 1.2,   # минимальная активность
        '2': 1.375, # низкая
        '3': 1.55,  # средняя
        '4': 1.725, # высокая
        '5': 1.9    # очень высокая
    }
    return bmr * factors.get(activity_level, 1.2)

def calculate_macros(calories, weight):
    """Расчёт КБЖУ (белки, жиры, углеводы)"""
    protein = 1.8 * weight  # 1.8 г на кг веса
    fat = 0.8 * weight      # 0.8 г на кг веса
    # Оставшиеся калории на углеводы
    carb_calories = calories - (protein * 4 + fat * 9)
    carbs = carb_calories / 4
    # Корректировка, чтобы не уходить в ноль/отрицательные углеводы
    if carbs < 0:
        carbs = 0
    return {
        'protein': round(protein, 1),
        'fat': round(fat, 1),
        'carbs': round(carbs, 1),
        'calories': round(calories)
    }

# ---------- РАБОТА С БАЗОЙ ДАННЫХ ----------
def init_db():
    conn = sqlite3.connect('calorie_tracker.db')
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS users (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    name TEXT,
                    weight REAL,
                    height REAL,
                    age INTEGER,
                    gender TEXT,
                    activity TEXT,
                    bmr REAL,
                    tdee REAL,
                    created_at TEXT
                )''')
    c.execute('''CREATE TABLE IF NOT EXISTS meals (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    user_id INTEGER,
                    date TEXT,
                    meal_type TEXT,
                    product TEXT,
                    calories REAL,
                    protein REAL,
                    fat REAL,
                    carbs REAL,
                    FOREIGN KEY (user_id) REFERENCES users (id)
                )''')
    conn.commit()
    conn.close()

def save_user_profile(name, weight, height, age, gender, activity, bmr, tdee):
    conn = sqlite3.connect('calorie_tracker.db')
    c = conn.cursor()
    c.execute('''INSERT INTO users 
                 (name, weight, height, age, gender, activity, bmr, tdee, created_at)
                 VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)''',
              (name, weight, height, age, gender, activity, bmr, tdee, datetime.now().isoformat()))
    user_id = c.lastrowid
    conn.commit()
    conn.close()
    return user_id

def get_last_user():
    conn = sqlite3.connect('calorie_tracker.db')
    c = conn.cursor()
    c.execute("SELECT id, name, weight, height, age, gender, activity, bmr, tdee FROM users ORDER BY id DESC LIMIT 1")
    user = c.fetchone()
    conn.close()
    return user

def add_meal(user_id, meal_type, product, calories, protein, fat, carbs):
    conn = sqlite3.connect('calorie_tracker.db')
    c = conn.cursor()
    c.execute('''INSERT INTO meals (user_id, date, meal_type, product, calories, protein, fat, carbs)
                 VALUES (?, ?, ?, ?, ?, ?, ?, ?)''',
              (user_id, datetime.now().date().isoformat(), meal_type, product, calories, protein, fat, carbs))
    conn.commit()
    conn.close()

def get_today_stats(user_id):
    conn = sqlite3.connect('calorie_tracker.db')
    c = conn.cursor()
    today = datetime.now().date().isoformat()
    c.execute('''SELECT SUM(calories), SUM(protein), SUM(fat), SUM(carbs) 
                 FROM meals WHERE user_id = ? AND date = ?''', (user_id, today))
    result = c.fetchone()
    conn.close()
    return {
        'calories': result[0] or 0,
        'protein': result[1] or 0,
        'fat': result[2] or 0,
        'carbs': result[3] or 0
    }

# ---------- ОСНОВНОЙ ЦИКЛ ПРИЛОЖЕНИЯ ----------
def main():
    init_db()
    print("=" * 50)
    print("🍏 ПРИЛОЖЕНИЕ ДЛЯ РАСЧЁТА КБЖУ И УЧЁТА КАЛОРИЙ")
    print("=" * 50)

    # Проверяем, есть ли сохранённый пользователь
    last_user = get_last_user()
    use_last = False
    if last_user:
        print(f"\n👤 Найден последний пользователь: {last_user[1]}")
        ans = input("Использовать этого пользователя? (y/n): ").lower()
        if ans == 'y':
            user_id, name, weight, height, age, gender, activity, bmr, tdee = last_user
            use_last = True
            print(f"✅ Загружен профиль: {name}")

    if not use_last:
        print("\n📝 Создание нового профиля")
        name = input("Имя: ")
        weight = float(input("Вес (кг): "))
        height = float(input("Рост (см): "))
        age = int(input("Возраст (лет): "))
        gender = input("Пол (male/female): ").lower()
        print("\nУровень активности:")
        print("1 - Минимальная (сидячая работа, без спорта)")
        print("2 - Низкая (лёгкие прогулки 1-2 раза в неделю)")
        print("3 - Средняя (тренировки 3-4 раза в неделю)")
        print("4 - Высокая (спорт 5-6 раз в неделю)")
        print("5 - Очень высокая (ежедневные тренировки + физическая работа)")
        activity = input("Выберите (1-5): ")

        bmr = calculate_bmr(weight, height, age, gender)
        tdee = calculate_tdee(bmr, activity)
        macros = calculate_macros(tdee, weight)

        print("\n📊 ВАША НОРМА КБЖУ ДЛЯ ПОДДЕРЖАНИЯ ВЕСА:")
        print(f"🔥 Калории: {macros['calories']} ккал/день")
        print(f"🥩 Белки: {macros['protein']} г")
        print(f"🥑 Жиры: {macros['fat']} г")
        print(f"🍚 Углеводы: {macros['carbs']} г")

        confirm = input("\nСохранить профиль? (y/n): ").lower()
        if confirm == 'y':
            user_id = save_user_profile(name, weight, height, age, gender, activity, bmr, tdee)
            print("✅ Профиль сохранён!")
        else:
            print("❌ Выход...")
            return

    # Главное меню учёта питания
    while True:
        # Получаем актуальные данные пользователя
        user_data = get_last_user()
        _, name, weight, _, _, _, _, _, tdee = user_data
        norms = calculate_macros(tdee, weight)
        today_stats = get_today_stats(user_id)

        print("\n" + "=" * 50)
        print(f"👋 Привет, {name}!")
        print(f"📅 Сегодня: {datetime.now().date()}")
        print(f"🎯 Норма калорий: {norms['calories']} ккал")
        print(f"✅ Съедено сегодня: {today_stats['calories']} ккал")
        print(f"⚡ Осталось: {max(0, norms['calories'] - today_stats['calories'])} ккал")
        print(f"🥩 Б: {today_stats['protein']}/{norms['protein']} г  "
              f"🥑 Ж: {today_stats['fat']}/{norms['fat']} г  "
              f"🍚 У: {today_stats['carbs']}/{norms['carbs']} г")
        print("=" * 50)
        print("1. Добавить приём пищи")
        print("2. Показать рекомендации по КБЖУ")
        print("3. Выйти")
        choice = input("Выберите действие: ")

        if choice == '1':
            print("\n📌 Тип приёма пищи:")
            print("1 - Завтрак  2 - Обед  3 - Ужин  4 - Перекус")
            meal_type_map = {'1': 'Завтрак', '2': 'Обед', '3': 'Ужин', '4': 'Перекус'}
            meal_type = meal_type_map.get(input("Номер: "), "Перекус")

            product = input("Название блюда/продукта: ")
            try:
                cal = float(input("Калории (ккал): "))
                prot = float(input("Белки (г): "))
                fat = float(input("Жиры (г): "))
                carbs = float(input("Углеводы (г): "))
                add_meal(user_id, meal_type, product, cal, prot, fat, carbs)
                print("✅ Добавлено!")
            except ValueError:
                print("❌ Ошибка ввода, попробуйте снова.")

        elif choice == '2':
            norm = calculate_macros(tdee, weight)
            print("\n📖 ИНДИВИДУАЛЬНЫЕ РЕКОМЕНДАЦИИ КБЖУ:")
            print(f"🔹 Для поддержания веса: {norm['calories']} ккал")
            print(f"🔹 Для похудения (дефицит -20%): {int(norm['calories'] * 0.8)} ккал")
            print(f"🔹 Для набора массы (профицит +20%): {int(norm['calories'] * 1.2)} ккал")
            print(f"\n🥩 Белки: {norm['protein']} г (1.8 г/кг веса)")
            print(f"🥑 Жиры: {norm['fat']} г (0.8 г/кг веса)")
            print(f"🍚 Углеводы: {norm['carbs']} г (остаток от калорий)")
            input("\nНажмите Enter для продолжения...")

        elif choice == '3':
            print("👋 До свидания!")
            break
        else:
            print("❌ Неверный ввод, попробуйте снова.")

if __name__ == "__main__":
    main()
